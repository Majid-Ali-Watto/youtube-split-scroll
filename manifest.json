{
  "manifest_version": 3,
  "name": "YouTube Split Scroll: Comments Left & Docked Player",
  "version": "1.2.0",
  "description": "Comments in the left column with independent scrolling; the player, title and actions dock to the right as you scroll.",
  "homepage_url": "https://majidev.netlify.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Split Scroll",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
